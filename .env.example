APP_NAME="Save It"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_CONNECTION=default

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=media-downloader-cache

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

EXTRACTOR_BASE_URL=http://extractor:8000
EXTRACTOR_TIMEOUT_SECONDS=15
EXTRACTOR_REQUEST_TIMEOUT_SECONDS=12
EXTRACTOR_CONNECT_TIMEOUT_SECONDS=2

DOWNLOAD_TOKEN_TTL_SECONDS=600
DOWNLOAD_JOB_TTL_SECONDS=3600
DOWNLOAD_CONNECT_TIMEOUT_SECONDS=3
DOWNLOAD_TIMEOUT_SECONDS=120
DOWNLOAD_MAX_REDIRECTS=3
DOWNLOAD_MAX_FILE_BYTES=536870912
DOWNLOAD_MAX_ZIP_ASSETS=20
DOWNLOAD_MAX_ZIP_BYTES=1073741824
DOWNLOAD_JOB_TIMEOUT_SECONDS=900

UMAMI_ENABLED=false
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Optional application-level abuse limits. Keep empty to use the safe defaults.
ABUSE_LIMIT_ANALYZE_PER_MINUTE=30
ABUSE_LIMIT_DOWNLOAD_PER_MINUTE=120
ABUSE_LIMIT_SHARE_PER_MINUTE=20
ABUSE_LIMIT_JOB_CREATE_PER_MINUTE=20
ABUSE_LIMIT_JOB_POLL_PER_MINUTE=120
ABUSE_LIMIT_PREVIEW_PER_MINUTE=60
ABUSE_LIMIT_INVALID_TOKEN_PER_MINUTE=15

# Optional Cloudflare Turnstile. Disabled installations remain anonymous.
TURNSTILE_ENABLED=false
TURNSTILE_PROTECT_ANALYZE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
